# Docker Environment Configuration
# Copy this file to .env and adjust values as needed

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Option 1: Gunakan PostgreSQL di Docker (default)
# Uncomment baris ini untuk menggunakan postgres container
# DATABASE_URL akan otomatis menggunakan default jika tidak diset
# DATABASE_URL=postgresql://postgres:qwert12345!@postgres:5432/satu_data_db

# Option 2: Gunakan PostgreSQL Eksternal (yang sudah ada)
# Uncomment dan sesuaikan dengan database Anda
# DATABASE_URL=postgresql://postgres:qwert12345!@host.docker.internal:5433/satu_data_db
# Atau jika di server lain:
# DATABASE_URL=postgresql://postgres:password@192.168.1.100:5432/satu_data_db

# ===========================================
# QWEN API CONFIGURATION
# ===========================================

# Qwen API Configuration
# If running Qwen on host machine, use host.docker.internal
QWEN_API_URL=http://host.docker.internal:9002/v1/chat/completions

# ===========================================
# MAINTENANCE MODE
# ===========================================

MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Sistem sedang dalam pemeliharaan
MAINTENANCE_ETA=

# ===========================================
# SWAGGER / API DOCS BASIC AUTH
# ===========================================
# Protects /docs, /redoc, and /openapi.json with HTTP Basic Auth.
# Leave blank in this example file; set real values in your server .env.
SWAGGER_AUTH_USERNAME=admin
SWAGGER_AUTH_PASSWORD=qwert12345!
SWAGGER_AUTH_REALM=Swagger
