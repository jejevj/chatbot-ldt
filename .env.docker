# Docker Environment Configuration
# Copy this file to .env and adjust values as needed

# Qwen API Configuration
# If running Qwen on host machine, use host.docker.internal
QWEN_API_URL=http://host.docker.internal:9002/v1/chat/completions

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Sistem sedang dalam pemeliharaan
MAINTENANCE_ETA=

# Database (handled by docker-compose)
# No need to change unless you modify docker-compose.yml
